# Copy to .env (never commit it). Used by docker compose via env_file.

# From BotFather. Keep it secret.
BOT_TOKEN=123456789:replace-me

# The bot's OWN login and database, never the superuser. The host is the Postgres container's
# name on the shared docker network. Special characters in the password must be URL-encoded
# (@ -> %40, / -> %2F, : -> %3A, # -> %23, % -> %25); a hex password avoids all of that:
#   openssl rand -hex 24
DATABASE_URL=postgres://pet_meds:replace-me@postgres:5432/pet_meds

# Where settings.yaml is inside the container (the compose file mounts it here).
SETTINGS_PATH=/config/settings.yaml

# debug | info | warn | error
LOG_LEVEL=info
